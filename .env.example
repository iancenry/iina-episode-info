# API keys for scripts/check-apis.mjs.
#
# Copy and add to .env to test the keys (the file is gitignored).
#
# TMDB is needed for the plugin's core identification. The DoesTheDogDie key
# is only used by the opt-in scene content warnings feature.

# themoviedb.org > Settings > API > Developer
TMDB_API_KEY=

# doesthedogdie.com > API (free tier, non-commercial)
DDD_API_KEY=
